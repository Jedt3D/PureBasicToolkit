{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "PureBasic",
  "scopeName": "source.purebasic",
  "patterns": [
    {
      "include": "#strings"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#procedureDefinitions"
    },
    {
      "include": "#structureDefinitions"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.semicolon.purebasic",
          "match": ";.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.purebasic",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.purebasic",
              "match": "\"\""
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.purebasic",
          "match": "\\$[0-9A-Fa-f]+"
        },
        {
          "name": "constant.numeric.binary.purebasic",
          "match": "%[01]+"
        },
        {
          "name": "constant.numeric.float.purebasic",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.purebasic",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.purebasic",
          "match": "\\b(?i:If|ElseIf|Else|EndIf|Select|Case|Default|EndSelect|For|To|Step|Next|ForEach|ForEver|While|Wend|Repeat|Until|Break|Continue|Goto|Return|End|CompilerIf|CompilerElse|CompilerElseIf|CompilerEndIf|CompilerSelect|CompilerCase|CompilerDefault|CompilerEndSelect|With|EndWith)\\b"
        },
        {
          "name": "keyword.other.purebasic",
          "match": "\\b(?i:Procedure|ProcedureC|ProcedureCDLL|ProcedureDLL|EndProcedure|ProcedureReturn|Declare|DeclareC|DeclareCDLL|DeclareDLL|Macro|EndMacro|Structure|EndStructure|Interface|EndInterface|Extends|StructureUnion|EndStructureUnion|Enumeration|EndEnumeration|EnumerationBinary|DeclareModule|EndDeclareModule|Module|EndModule|UseModule|UnuseModule|Array|List|Map|NewList|NewMap|Protected|Global|Shared|Static|Threaded|Define|Dim|ReDim|Data|DataSection|EndDataSection|Read|Restore|Import|ImportC|EndImport|IncludeFile|XIncludeFile|IncludeBinary|IncludePath|EnableExplicit|DisableExplicit|EnableASM|DisableASM|CallDebugger|Debug|DebugLevel|DisableDebugger|EnableDebugger|Runtime)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.purebasic",
          "match": "\\.(?i:[bwlqfdsiacu])\\b"
        },
        {
          "name": "storage.type.purebasic",
          "match": "\\b(?i:Byte|Word|Long|Quad|Float|Double|String|Integer|Character|Ascii|Unicode)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.purebasic",
          "match": "\\b(?i:#True|#False|#Null|#NUL|#LF|#CRLF|#CR|#FF|#TAB|#DOUBLEQUOTE)\\b"
        },
        {
          "name": "constant.other.purebasic",
          "match": "#[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "procedureDefinitions": {
      "patterns": [
        {
          "name": "meta.function.definition.purebasic",
          "match": "\\b(?i:Procedure|ProcedureC|ProcedureCDLL|ProcedureDLL|Declare|DeclareC|DeclareCDLL|DeclareDLL)(?:\\.[bwlqfdsiacu])?\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "entity.name.function.definition.purebasic"
            }
          }
        }
      ]
    },
    "structureDefinitions": {
      "patterns": [
        {
          "name": "meta.type.definition.purebasic",
          "match": "\\b(?i:Structure|Interface|Module|DeclareModule)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "entity.name.type.purebasic"
            }
          }
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.purebasic",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.purebasic",
          "match": "\\b(?i:And|Or|XOr|Not)\\b"
        },
        {
          "name": "keyword.operator.comparison.purebasic",
          "match": "(<>|<=|>=|<|>|=)"
        },
        {
          "name": "keyword.operator.arithmetic.purebasic",
          "match": "(\\+|\\-|\\*|/|%|<<|>>|&|\\||!)"
        }
      ]
    }
  }
}
